# ENERGEX inquiry delivery — configuration reference. Never commit real values.
# Copy to .env.local for local testing. Delivery stays disabled unless every
# required server value is present AND INQUIRY_DELIVERY_ENABLED=true.
#
# Do not enable in production until these are approved: recipient inbox,
# ENERGEX-owned verified sending domain (SPF/DKIM/DMARC), Resend account,
# commercial Vercel plan, privacy/collection notice, email retention policy,
# and production bot-protection and rate-limit settings.

# --- Server only (never prefix with NEXT_PUBLIC_) ---
INQUIRY_DELIVERY_ENABLED=false
RESEND_API_KEY=
# "Display Name <address@verified-domain>" or a bare address on a domain verified in Resend.
INQUIRY_FROM=
# Single approved recipient address per inquiry type (may be the same inbox).
INQUIRY_TO_PROJECT=
INQUIRY_TO_EQUIPMENT=
TURNSTILE_SECRET_KEY=
# Comma-separated exact origins allowed to POST /api/inquiry, e.g. https://www.example.com
INQUIRY_ALLOWED_ORIGINS=
# Shared rate-limit store. Required on every host unless INQUIRY_ALLOW_TEST_MODE=true.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Max emails handed to Resend per UTC day across all visitors (default 100).
# Technical safeguard: confirm against expected inquiry volume.
INQUIRY_GLOBAL_DAILY_LIMIT=
# Local/preview testing only: allows the per-instance memory rate limiter and
# Cloudflare Turnstile testing keys. Refused when VERCEL_ENV=production.
INQUIRY_ALLOW_TEST_MODE=false
#
# Notes:
# - Duplicate suppression across serverless instances relies on Resend's
#   Idempotency-Key handling; the local idempotency store is per instance.
# - The client IP is read from x-real-ip / x-forwarded-for, which must be set
#   by a trusted edge (Vercel). Requests without a usable IP are refused.

# --- Browser-visible (inlined at build time; non-secret) ---
# Set together with INQUIRY_DELIVERY_ENABLED and redeploy. The server decides at
# runtime; a mismatch fails safe (the form reports that nothing was sent).
NEXT_PUBLIC_INQUIRY_DELIVERY_ENABLED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
